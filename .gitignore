# Secrets and local configuration
.env

# Per-app deployment values (secrets, domains) - server only
env/

# Local compose file (copy of docker-compose.example.yml, may contain
# local edits like the enabled db service - never commit)
docker-compose.yml

# Files generated by deploy.sh from app manifests
docker-compose.override.yml
.deploy/

# Cloned application repositories (deploy.sh fetches them)
repos/

# Database backups
backups/

# Logs
*.log

# Python cache
__pycache__/
