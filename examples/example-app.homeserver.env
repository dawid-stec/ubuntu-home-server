# Deployment manifest for an example application.
# Copy this file to the root of your application repository as `homeserver.env`
# and commit it. Plain declaration only (KEY=VALUE), no secrets.
# Values (domain, secrets, database URL) live only on the server
# in env/<app>.env; deploy creates that template for you.

# Compose service name (must be unique on the server).
SERVICE=example-api
# Dockerfile relative to the repository root (CONTEXT below).
DOCKERFILE=Dockerfile
CONTEXT=.
# Port the application listens on INSIDE the container.
PORT=3000
# Public app (requires PUBLIC_HOSTNAME set on the server).
PUBLIC=true
# Image has a healthcheck (deploy waits for healthy status).
HEALTHCHECK=true
# Variables that MUST be set on the server (env/example-app.env).
# WEB_URL and CORS_ORIGINS are derived by deploy from PUBLIC_HOSTNAME.
# An app that needs a database lists DATABASE_URL here and sets it
# explicitly per app, even when it points at the optional local Postgres.
REQUIRED_ENV=DATABASE_URL,APP_SECRET
