# ============================================================================
# Server configuration. Copy this file to .env (setup-server.sh does it)
# and fill in values marked REQUIRED.
# NEVER commit .env to git.
#
# This file holds ONLY server infrastructure configuration. Per-application
# values (domains, secrets, DATABASE_URL) do NOT live here. An application
# declares variable names in its homeserver.env manifest, and you set values
# on the server in env/<app>.env.
# ============================================================================

# ---------- REQUIRED ----------

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> cloudflared).
# Paste the whole token starting with "eyJ...".
TUNNEL_TOKEN=

# Application repositories that deploy.sh clones/updates.
# Format: directory_name=repo_url#branch - entries separated by COMMAS
# (no spaces; spaces break .env parsing).
# Each repo must contain a homeserver.env manifest, or a fallback
# manifests/<directory_name>.homeserver.env in THIS repo (see README:
# "Add an application" and examples/example-app.homeserver.env).
# Private repo: use an access token in the URL:
#   my_app=https://x-access-token:<TOKEN>@github.com/your-user/your-app.git#main
APP_REPOS=

# ---------- SET AUTOMATICALLY by setup-server.sh ----------

# Password for the optional local PostgreSQL (see docker-compose.yml).
# Only used when you uncomment the db service. Existing installations:
# never change this after first database start.
DB_PASSWORD=

# ---------- Cloudflare API (optional, recommended) ----------
# Without these, deploy still works, but tunnel Public Hostnames must be
# set manually in the dashboard (deploy prints the desired routes).
# API token: one.dash.cloudflare.com -> My Profile -> API Tokens, with
# Account: Cloudflare Tunnel Edit + Zone: DNS Edit. Account ID and Tunnel ID
# are shown in the Cloudflare dashboard (Tunnel ID ends the tunnel URL).
# CF_ZONE_ID: optional globally; each app can override it in env/<app>.env.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_TUNNEL_ID=
CF_ZONE_ID=
